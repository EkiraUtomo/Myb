# Required
LOCKER_MASTER_SECRET=replace-with-a-random-secret-at-least-32-chars
LOCKER_SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-chars
GITHUB_TOKEN=
LOCKER_GITHUB_OWNER=
LOCKER_GITHUB_REPO=
LOCKER_GITHUB_BRANCH=main

# Recommended security defaults
PUBLIC_BASE_URL=https://zumhub.vercel.app
LOCKER_DEBUG_SECURITY=false
LOCKER_BIND_SESSION_IP=false
LOCKER_L_REQUIRE_PRESENCE=false

# Migration-only compatibility; keep false after all scripts/keys are re-saved.
LOCKER_ALLOW_LEGACY_PAYLOAD=false
LOCKER_ALLOW_LEGACY_ACCESS_KEYS=false

# Discord
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_USERNAME=ZumHub Security
DISCORD_WEBHOOK_DEDUPE_MS=5000
DISCORD_SHOW_RAW_IP=true
DISCORD_SHOW_USER_AGENT=false
